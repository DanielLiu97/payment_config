# ===== 支付配置校验工具 · 环境变量示例 =====
# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会提交）
# Windows 用户可参考 scripts/windows/web_service.env.ps1.example

# 【必填】星宿平台管理后台 Cookie（从浏览器开发者工具复制 ovsmgr_sid=xxx）
PAYMENT_ADMIN_COOKIE=ovsmgr_sid=your_cookie_here

# 【可选】Bot Webhook（用于推送校验结果到群）
BOT_WEBHOOK_URL=
BOT_DEBUG_WEBHOOK_URLS=

# 【可选】内部应用标识
PAYMENT_X_APP_ID=

# 【可选】Web 服务访问令牌
WEB_ACCESS_TOKEN=change_me

# 【可选】API 地址（默认为 example.com 占位，请改为实际内部地址）
ADMIN_API_BASE_URL=https://example.com/shopwindow/shop-admin/manage/1
PRODUCT_LISTNEW_BASE_URL=https://example.com/shopwindow/shop-admin/manage/1
PAY_WINDOW_ONLINE_BASE_URL=https://example.com
PAY_WINDOW_TEST_BASE_URL=https://example.com
